{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inky",
  "version": "0.1.0",
  "identifier": "com.inky.app",
  "build": {
    "beforeDevCommand": "pnpm mcp:bundle && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm mcp:bundle && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Inky",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Visible",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQkQ5Qzc3NjMyMjIwQzcKUldUSElDSmpkNXk5cmQ0VDNQUUZCbVhyMFdIY2g2cU82SmJNV1E2RXM4QUdyd0RlOXhOci9semQK",
      "endpoints": [
        "https://github.com/juanjo/inky/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": ["../mcp/server.bundle.mjs"],
    "category": "Productivity",
    "shortDescription": "A pleasant markdown reader and editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
